BUCKSPAY_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# This host is shared with development: the gateway refuses mainnet here.
SHARED_HOST=true
# production or short; the program id follows the profile (PROGRAM_ID, if set, must be that id).
BUCKSPAY_PROFILE=production
# The one mint locks are sponsored for (devnet USDC).
MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
MAX_PRIORITY_FEE=100000
REQUESTS_PER_MINUTE=30
# Permanent cost the gateway will spend on onboarding in total, in lamports.
CAC_BUDGET_LAMPORTS=500000000
# Rent lent out at once (open locks, pending rotations, what is being prepared), in lamports.
OPEN_RENT_CAP_LAMPORTS=600000000
SPONSORED_DAILY_ONBOARDINGS=200
SPONSORED_PER_PREFIX_PER_DAY=5
SPONSORED_PER_PREFIX_PER_30_DAYS=10
PREPARING_PER_PREFIX=3
SPONSORED_MAX_LOCK_DAYS=45
# The minimum sponsored funding climbs with the load: percent:funding pairs, ascending.
MIN_SPONSORED_FUNDING=2000000
ESCALATION_STEPS=50:5000000,65:10000000,80:25000000,90:50000000
ESCALATION_FEE_ON_PERCENT=50
ESCALATION_FEE_OFF_PERCENT=40
# off or cost_plus. The escalation can force cost_plus, never lower it; cost_plus needs a price and
# the fee payer's associated token account of the mint.
ONBOARDING_FEE_MODE=off
#SOL_PRICE_MICRO_USDC=120490000
#FEE_TOKEN_ACCOUNT=
# Other addresses the gateway signs for, comma separated: no endpoint accepts them as a wallet.
#GATEWAY_KEYS=
